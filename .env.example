# Required
GEMINI_API_KEY=your_gemini_api_key_here

# Optional - Media Download
COOKIES_PATH=/path/to/cookies.txt
YOUTUBE_VISITOR_DATA=your_visitor_data_here

# Optional - Have I Been Pwned
